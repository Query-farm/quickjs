# name: test/sql/quickjs_nulls.test
# description: NULLs, table columns, non-constant scripts, empty input, async functions and error paths
# group: [quickjs]

require quickjs

statement ok
CREATE TABLE scripts AS SELECT * FROM (VALUES
  (1, '(x) => x + 1', 10),
  (2, '(x) => x * 10', 20),
  (3, NULL, 30),
  (4, '(x) => x + 1', NULL),
  (5, '(x) => x === null', NULL),
  (6, '(x) => String(x).toUpperCase()', 7)
) t(id, fn, arg);

# Non-constant scripts and arguments, NULL script -> NULL, NULL argument -> JavaScript null
query II
SELECT id, quickjs_eval(fn, arg) FROM scripts ORDER BY id;
----
1	11
2	200
3	NULL
4	1
5	true
6	"7"

query II
SELECT id, quickjs(fn) IS NULL FROM scripts ORDER BY id;
----
1	false
2	false
3	true
4	false
5	false
6	false

query I
SELECT quickjs(NULL);
----
NULL

query I
SELECT quickjs_eval(NULL, 1);
----
NULL

query I
SELECT quickjs_eval('(x) => x === null', NULL);
----
true

query I
SELECT quickjs_eval('(...a) => a.length', NULL, NULL, 1);
----
3

statement error
SELECT * FROM quickjs(NULL);
----
non-null

# Larger than one vector, mixed per-row scripts
query I
SELECT sum(quickjs_eval(CASE WHEN i % 2 = 0 THEN '(x) => x' ELSE '(x) => -x' END, i)::BIGINT) FROM range(5000) t(i);
----
-2500

query I
SELECT sum(quickjs(i::VARCHAR || ' * 2')::BIGINT) FROM range(3000) t(i);
----
8997000

# Each quickjs() row gets a fresh context: top-level declarations never collide between rows
query I
SELECT count(DISTINCT quickjs('let msg = "x" + ' || i::VARCHAR || '; msg')) FROM range(100) t(i);
----
100

# Empty
query I
SELECT quickjs('');
----
undefined

query I
SELECT count(*) FROM quickjs('[]');
----
0

query I
SELECT count(*) FROM quickjs('Array.from({length: 5000}, (_, i) => i)');
----
5000

query I
SELECT quickjs_eval('() => ""');
----
""

# async functions and promises are awaited
query I
SELECT quickjs_eval('async (x) => { await null; return x * 2 }', 21);
----
42

query I
SELECT quickjs('Promise.resolve(5)');
----
5

query I
SELECT * FROM quickjs('(async () => [1, 2])()');
----
1
2

statement error
SELECT quickjs_eval('async () => { throw new Error("boom") }');
----
JavaScript promise rejected: Error: boom

statement error
SELECT quickjs('new Promise(() => {})');
----
promise never settled

# Error paths
statement error
SELECT quickjs('this is not javascript');
----
SyntaxError

statement error
SELECT quickjs_eval('42', 1);
----
First argument to quickjs_eval must be a function

statement error
SELECT quickjs_eval('(x) => { throw new RangeError("bad " + x) }', 7);
----
RangeError: bad 7

statement error
SELECT * FROM quickjs('42');
----
JavaScript code must return an array

statement error
SELECT quickjs_eval('() => { const o = {}; o.self = o; return o }');
----
Failed to stringify result to JSON
